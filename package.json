{
  "name": "claude-remote-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @claude-remote/web dev",
    "build": "pnpm -r build",
    "start": "tsx scripts/start.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "setup": "tsx scripts/setup.ts",
    "launchagent:install": "tsx scripts/install-launch-agent.ts",
    "launchagent:uninstall": "tsx scripts/uninstall-launch-agent.ts",
    "e2e": "playwright test",
    "crm": "tsx scripts/crm.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.38.0"
  }
}
