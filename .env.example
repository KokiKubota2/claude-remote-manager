# --- 実行環境 ---
NODE_ENV=development

# --- Web管理画面 ---
WEB_HOST=127.0.0.1
WEB_PORT=32146
# ログイン用トークン。`openssl rand -hex 32` などで生成した長いランダム値を設定する
WEB_AUTH_TOKEN=

# --- データベース ---
DATABASE_PATH=./data/claude-remote.sqlite

# --- Slack(未設定の場合はモックアダプタで動作) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
# カンマ区切りで複数指定可
ALLOWED_SLACK_USER_IDS=

# --- プロジェクト・worktree ---
PROJECT_CONFIG_PATH=./config/projects.yaml
WORKTREE_ROOT=~/.claude-remote/worktrees

# --- 外部コマンド ---
CLAUDE_COMMAND=claude
GIT_COMMAND=git

# --- ジョブ制御 ---
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_JOBS_PER_PROJECT=1
PERMISSION_TIMEOUT_SECONDS=3600

# --- ロギング ---
LOG_LEVEL=info
